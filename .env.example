# Copier en .env (non commité) et renseigner.
# --- Phase A : DuckDB (Eunomia GiBleed) ---
OMOP_DUCKDB_PATH=data/gibleed.duckdb

# --- Phase B : PostgreSQL (docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omop
POSTGRES_USER=omop
POSTGRES_PASSWORD=change_me
CDM_SCHEMA=cdm
SYNTHEA_SCHEMA=native
RESULTS_SCHEMA=results

# --- Pilotes JDBC (DatabaseConnector) ---
DATABASECONNECTOR_JAR_FOLDER=data/jdbc

# --- Phase B : vocabulaires Athena (CSV décompressés, séparateur tabulation) ---
VOCAB_DIR=data/vocab
# TRUE = chargement massif via psql (nécessite le client PostgreSQL et POSTGRES_PATH)
VOCAB_BULK_LOAD=FALSE
# Dossier contenant psql (requis si VOCAB_BULK_LOAD=TRUE)
POSTGRES_PATH=/usr/bin
